{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "ShopEase/EC2",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] },
      "cpu": { "measurement": ["cpu_usage_idle", "cpu_usage_user", "cpu_usage_system"], "totalcpu": true },
      "swap": { "measurement": ["swap_used_percent"] }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/containers/shopease-*_shopease_*.log",
            "log_group_name": "/shopease/app",
            "log_stream_name": "{instance_id}-app",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/jenkins/jenkins.log",
            "log_group_name": "/shopease/jenkins",
            "log_stream_name": "{instance_id}-jenkins",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "/shopease/system",
            "log_stream_name": "{instance_id}-syslog",
            "retention_in_days": 7
          }
        ]
      }
    }
  }
}
